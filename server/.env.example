# 複製成 server/.env 後依需要修改（伺服器啟動時會自動讀取）

# 只在本機監聽，外部一律經由 Cloudflare Tunnel 進來（較安全）
BIND=127.0.0.1
PORT=8080

# 信任 Cloudflare 傳來的用戶端真實 IP（密碼嘗試次數限制需要）
TRUST_PROXY=1

# STUN（協助 P2P 直連）
STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# Cloudflare TURN（選用）：嚴格網路下 P2P 打不通時改走中繼
# Cloudflare 後台 → Realtime → TURN Server → Create，取得 Key ID 與 API Token
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
